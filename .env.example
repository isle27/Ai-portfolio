# Shared Neon connection string (pooled URL, sslmode=require).
# Tables initialize automatically before the first database operation.
# The role needs CREATE/ALTER on the public portfolio tables.
# Never prefix this secret with NEXT_PUBLIC_.
DATABASE_URL=
# Use your actual canonical deployment URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional verified contact details (omit until confirmed)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
# Stable random secret for privacy-preserving contact rate limits (32+ chars)
CONTACT_RATE_LIMIT_SECRET=
# Direct private notifications, server-only. Start a conversation with your bot first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Contact form email delivery via Resend (server-only API key and verified sender).
# NEXT_PUBLIC_CONTACT_EMAIL above is the recipient and optional public mailto link.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
