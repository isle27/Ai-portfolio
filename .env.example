# Shared Neon connection string (pooled URL, sslmode=require).
# Tables initialize automatically before the first database operation.
# The role needs CREATE/ALTER on the public portfolio tables.
# Never prefix this secret with NEXT_PUBLIC_.
DATABASE_URL=
# Use your actual canonical deployment URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional verified contact details (omit until confirmed)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=https://github.com/isle27
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
